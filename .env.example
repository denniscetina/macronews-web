# Runtime environment: production | qas | development
APP_ENV=development

# Public URL of this frontend (canonical URLs, sitemap)
SITE_URL=http://localhost:3000

# CMS (WordPress headless) - generate token/key in CMS > Site Settings > Advanced
# API root, e.g. https://cms.macronews.mx/wp-json/api/v1 (a trailing /site is tolerated)
WEB_API_URL=https://cms.macronews.mx/wp-json/api/v1
WEB_API_URL_PREVIEW=
WEB_API_HEADER_KEY=
WEB_API_TOKEN=

# Secret the CMS sends to /revalidate (as `token` param/body field or Authorization: Bearer)
REVALIDATE_TOKEN=

# Secret the CMS sends to /api/draft to enable preview (draft mode)
DRAFT_MODE_TOKEN=

# Banco de México SIE API token (free: https://www.banxico.org.mx/SieAPIRest/service/v1/token).
# Feeds the USD/MXN and EUR/MXN widgets of the top bar; without it they are hidden.
BANXICO_TOKEN=
